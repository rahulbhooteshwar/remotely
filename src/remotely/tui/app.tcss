/* Remotely - terminal styling */

Screen {
    background: #0b0e14;
    color: #c5cede;
}

#root {
    height: 1fr;
}

#banner {
    height: 1;
    padding: 0 1;
    background: #11151c;
    color: #8b98b0;
}

#command-bar {
    margin: 1 1 0 1;
    border: tall #2a3446;
    background: #11151c;
}

#command-bar:focus {
    border: tall #7aa2f7;
}

/* The switcher must claim the space left over inside #root. Without an
   explicit height its terminal child sizes itself against the whole screen,
   overruns the footer and pushes the status line off the bottom. */
#content {
    height: 1fr;
    width: 100%;
}

#body {
    height: 1fr;
    margin: 1 1 0 1;
}

#launcher {
    height: 100%;
}

#results {
    width: 2fr;
    border: round #2a3446;
    background: #0d1117;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#results:focus {
    border: round #2a3446;
}

#detail-pane {
    width: 1fr;
    border: round #2a3446;
    background: #0d1117;
    padding: 0 1;
    margin-left: 1;
    scrollbar-size-vertical: 1;
}

#status {
    height: auto;
    min-height: 1;
    padding: 0 2;
    color: #8b98b0;
}

#status.error {
    color: #ff7b72;
}

.error {
    color: #ff7b72;
    height: auto;
}

/* ------------------------------------------------------------------ modals */

/* Centre every dialog and dim what is behind it, so the launcher stays visible
   for context while the dialog is unmistakably the thing being asked of you. */
ModalScreen {
    align: center middle;
    background: #05070b 65%;
}

.modal {
    background: #11151c;
    border: thick #2a3446;
    padding: 1 2;
}

/* The passcode prompt is the one dialog that appears unprompted, in the middle
   of doing something else, so it gets a louder treatment than the rest. */
.modal-passcode {
    border: thick #7aa2f7;
    background: #131a26;
    padding: 1 3;
}

.modal-passcode .modal-title {
    text-style: bold;
    color: #cddcff;
    background: #7aa2f7 20%;
    width: 100%;
    padding: 0 1;
    text-align: center;
}

.modal-passcode Input {
    border: tall #3d5a99;
}

.modal-passcode Input:focus {
    border: tall #7aa2f7;
}

.modal-narrow {
    width: 60;
    max-width: 100%;
    height: auto;
    max-height: 80%;
}

/* max-width matters as much as the height cap: a large font also means
   fewer columns, and a fixed 84 wide pushes the right-aligned Save button
   clean off the screen edge. */
.modal-wide {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 90%;
}

.modal-title {
    text-style: bold;
    color: #7aa2f7;
    padding-bottom: 1;
}

.modal-help {
    color: #8b98b0;
    padding-bottom: 1;
    height: auto;
}

.modal-footnote {
    color: #6b7a94;
    text-style: italic;
    padding-top: 1;
    height: auto;
}

.modal-help.empty {
    padding: 2 0;
    text-align: center;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}

.modal-buttons Button {
    margin-left: 2;
    min-width: 12;
}

/* Takes whatever the dialog has left over after the title and the buttons,
   rather than a fixed number of rows. A hard cap (it was 24) can be taller
   than the entire dialog on a short terminal - which is exactly what a large
   font gives you - so the fields pushed the buttons off the bottom and Save
   became unreachable. Flexing keeps them on screen at any size. */
.form-scroll {
    height: 1fr;
    min-height: 3;
    scrollbar-size-vertical: 1;
}

/* Applied by CompactOnSmall when the terminal is too short to afford chrome.
   Every row of padding here is a row the form fields do not get: at 14 rows
   the normal chrome leaves a one-row viewport. */
.modal.compact {
    padding: 0 2;
}

.modal.compact .modal-title {
    padding-bottom: 0;
}

.modal.compact .modal-buttons {
    padding-top: 0;
}

.modal-wide.compact,
.modal-narrow.compact {
    max-height: 100%;
}

.field {
    height: auto;
    padding-bottom: 1;
    width: 1fr;
}

.field-row {
    height: auto;
}

.field-row .field {
    margin-right: 2;
}

.field-label {
    color: #8b98b0;
}

.modal OptionList {
    height: auto;
    max-height: 22;
    background: #0d1117;
    border: round #2a3446;
    padding: 0 1;
}

MyOptionList > .option-list--option-highlighted,
OptionList > .option-list--option-highlighted {
    background: #1f2937;
    color: #e6edf3;
    text-style: bold;
}

Input {
    background: #0d1117;
    border: tall #2a3446;
}

Input:focus {
    border: tall #7aa2f7;
}

Select {
    background: #0d1117;
}

Footer {
    background: #11151c;
}
